# Website API
NEXT_PUBLIC_WEBSITE_URL=https://acme.co.uk
NEXT_PUBLIC_WEBSITE_API_BASE=https://acme.co.uk/api
WEBSITE_API_TOKEN=your_api_token_here
WEBSITE_API_SECRET=your_api_secret_here

# Vercel AI Gateway (vision + content generation)
# Create a key at vercel.com → AI Gateway → API Keys. On Vercel deployments
# this can be left unset: the project's OIDC token is used automatically.
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here
# Optional: any gateway model ID (default: anthropic/claude-sonnet-5.5)
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5

# Buffer.com (social media scheduling)
BUFFER_API_TOKEN=your_buffer_api_token_here
# Comma-separated, in this order: linkedin,instagram,twitter
BUFFER_PROFILE_IDS=linkedin_profile_id,instagram_profile_id,twitter_profile_id

# Google Maps (leads scraper - Phase 2)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here
GOOGLE_MAPS_RATE_LIMIT=1000

# LinkedIn API (leads scraper - Phase 3)
LINKEDIN_API_KEY=optional_for_phase_3

# MongoDB (for caching/leads storage)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/photo-engine
MONGODB_DB_NAME=photo-engine

# Feature flags
ENABLE_BUFFER_POSTING=false
ENABLE_LEADS_SCRAPER=false
ENABLE_WEBSITE_AUTO_POST=false
NODE_ENV=development

# Logging
LOG_LEVEL=info
