# ---------------------------------------------------------------------------
# Photo Content Engine — environment variables
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables and redeploy.
# Nothing here is required to try the app locally: without keys it runs in
# sandbox mode with temporary storage.
# ---------------------------------------------------------------------------

# --- Sign-in (required) -----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Email + password accounts: comma-separated email|hash pairs.
# Create each entry with: npm run hash-password -- you@example.com
AUTH_USERS=

# Optional: Microsoft 365 sign-in for your company tenant (blank = hidden)
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Must contain your Directory (tenant) ID, not "common"
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/YOUR_TENANT_ID/v2.0
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=

# --- AI (Vercel AI Gateway) -------------------------------------------------
# Not needed on Vercel (it signs in with the project's OIDC token).
AI_GATEWAY_API_KEY=
# Optional: any gateway model ID
AI_GATEWAY_MODEL=anthropic/claude-sonnet-5.5

# --- Storage ----------------------------------------------------------------
# Jobs, sandbox posts and cached reports. Required on Vercel.
MONGODB_URI=
MONGODB_DB_NAME=photo-engine
# Photo hosting with public URLs (Buffer/Instagram need them). Vercel → Storage → Blob adds this.
BLOB_READ_WRITE_TOKEN=

# --- Buffer (LinkedIn + Instagram scheduling) -------------------------------
# Buffer → Settings → API → create a key. Blank = sandbox mode.
BUFFER_API_KEY=
# Must be "true" to create/edit/delete real posts. Otherwise live mode is read-only.
ENABLE_BUFFER_POSTING=false
# Optional: if your Buffer account has several organizations
BUFFER_ORGANIZATION_ID=
# Optional: force sandbox even with a key
# SOCIAL_MODE=sandbox

# --- Company website ---------------------------------------------------------
# Website admin → /admin/api-keys: role editor, scopes content:write,
# media:write, analytics:read. Starts with cc_live_.
# Easier: set the address and key in the app's Settings → Website (saved
# encrypted in the database). These are only the fallback.
WEBSITE_API_KEY=
NEXT_PUBLIC_WEBSITE_URL=

# --- DataForSEO (Search & market, Reputation & authority) -------------------
# dataforseo.com → API Access. Pay per request; pages only read stored results.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# "true" = free sandbox with dummy data
DATAFORSEO_SANDBOX=false
# USD per calendar month; refreshes stop when it's reached
DATAFORSEO_MONTHLY_BUDGET=20

# --- Other systems (POST /api/v1/jobs) --------------------------------------
# Comma-separated name:key pairs. Create one with: npm run new-api-key -- atlas
INTEGRATION_API_KEYS=

# --- Weekly growth check (Focus → Run it automatically) ---------------------
# Any long random string; Vercel Cron sends it so only Vercel can trigger runs.
CRON_SECRET=

# --- Display ----------------------------------------------------------------
NEXT_PUBLIC_APP_TIMEZONE=Europe/London
